<?xml version="1.0"?>
<rdf:RDF xmlns="http://it.univaq.disim/mrs/ontology#"
     xml:base="http://it.univaq.disim/mrs/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    
    <owl:Ontology rdf:about="http://it.univaq.disim/mrs/ontology"/>

    <owl:Class rdf:about="http://it.univaq.disim/mrs/ontology#Coordinate"/>
    
    <owl:Class rdf:about="http://it.univaq.disim/mrs/ontology#MapData">
        <rdfs:subClassOf rdf:resource="http://it.univaq.disim/mrs/ontology#Coordinate"/>
    </owl:Class>

    <owl:Class rdf:about="http://it.univaq.disim/mrs/ontology#ClosestTractorData">
        <rdfs:subClassOf rdf:resource="http://it.univaq.disim/mrs/ontology#Coordinate"/>
    </owl:Class>

    <owl:Class rdf:about="http://it.univaq.disim/mrs/ontology#Boolean"/>

</rdf:RDF>